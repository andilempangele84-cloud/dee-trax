# Application Settings
APP_NAME=HelperGrid AI Engine
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# LLM Provider Keys
# OpenAI
OPENAI_API_KEY=your_openai_key_here
OPENAI_ORG_ID=optional_org_id

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Google Gemini
GOOGLE_API_KEY=your_google_api_key_here

# Replicate
REPLICATE_API_TOKEN=your_replicate_token_here

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/helpergrid_ai
MONGODB_URL=mongodb://localhost:27017/helpergrid_ai
REDIS_URL=redis://localhost:6379/0

# Vector Database
# Pinecone
PINCONE_API_KEY=your_pinecone_key_here
PINCONE_ENVIRONMENT=gcp-starter
PINCONE_INDEX_NAME=helpergrid-embeddings

# Weaviate
WEAVIATE_URL=http://localhost:8080

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Authentication
JWT_SECRET_KEY=your_jwt_secret_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Keys for Third-party Services
STRIPE_API_KEY=your_stripe_key_here
MAILGUN_API_KEY=your_mailgun_key_here
TWILIO_API_KEY=your_twilio_key_here
SLACK_BOT_TOKEN=your_slack_token_here
GOOGLE_CALENDAR_API_KEY=your_google_calendar_key_here

# Model Configuration
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4
TEMPERATURE=0.7
MAX_TOKENS=2000
TOP_P=0.9

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Monitoring & Logging
SENTRY_DSN=optional_sentry_dsn
MLFLOW_TRACKING_URI=http://localhost:5000
WANDB_API_KEY=optional_wandb_key
WANDB_PROJECT=helpergrid-ai

# Redis Caching
REDIS_TTL_SECONDS=3600
CACHE_ENABLED=True

# Feature Flags
EXPERIMENTAL_FEATURES=False
RAG_ENABLED=True
FINE_TUNING_ENABLED=True
CUSTOM_MODELS_ENABLED=True
